---
interface Props {
  value: string;
  label: string;
  context: string;
}
const { value, label, context } = Astro.props;
---

<div style="background-color:#1E293B;border:1px solid #334155;border-left:4px solid #06B6D4;border-radius:0.75rem;padding:1.5rem 1.75rem;margin:2rem 0;">
  <div style="display:flex;flex-wrap:wrap;align-items:baseline;gap:0.75rem;margin-bottom:0.5rem;">
    <span style="color:#06B6D4;font-size:2.5rem;font-weight:700;line-height:1;">{value}</span>
    <span style="color:#F8FAFC;font-size:1rem;font-weight:600;">{label}</span>
  </div>
  <p style="color:#64748B;font-size:0.85rem;line-height:1.6;margin:0;">{context}</p>
</div>
