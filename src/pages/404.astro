---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Not Found">
  <div style="max-width:40rem;margin:6rem auto;padding:0 1.5rem;text-align:center;">
    <p style="color:#06B6D4;font-size:0.75rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;margin:0 0 0.75rem 0;">404</p>
    <h1 style="color:#F8FAFC;font-size:2rem;font-weight:700;margin:0 0 1rem 0;">Page not found</h1>
    <p style="color:#64748B;font-size:0.95rem;margin:0 0 2rem 0;">The page you're looking for doesn't exist or has moved.</p>
    <a href="/" style="background-color:#06B6D4;color:#0F172A;font-weight:700;font-size:0.875rem;padding:10px 24px;border-radius:6px;text-decoration:none;">
      Back to home
    </a>
  </div>
</BaseLayout>
