---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const letters = ['political','economic','social','technological','legal','environmental'];
  return letters.map((letter) => ({ params: { letter } }));
}

const { letter } = Astro.params;
const labelTitle = letter.charAt(0).toUpperCase() + letter.slice(1);

const allPosts = await getCollection('posts');
const filtered = allPosts
  .filter((p) => p.data.pestle.some((tag) => tag.toLowerCase() === letter))
  .sort((a, b) => b.data.published_at.getTime() - a.data.published_at.getTime());
---

<BaseLayout title={`${labelTitle} lens`} description={`LinAI posts through the ${labelTitle} lens.`}>
  <section class="max-w-6xl mx-auto px-4 py-10">
    <div style="margin-bottom:2rem;">
      <a href="/" style="color:#64748B;font-size:0.8rem;text-decoration:none;display:inline-flex;align-items:center;gap:4px;margin-bottom:1rem;">
        ← All posts
      </a>
      <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.5rem;">
        <span style="font-size:0.7rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#06B6D4;">PESTLE</span>
        <h1 style="color:#F8FAFC;font-size:2rem;font-weight:700;margin:0;">{labelTitle}</h1>
      </div>
      <p style="color:#64748B;font-size:0.875rem;margin:0;">{filtered.length} {filtered.length === 1 ? 'post' : 'posts'}</p>
    </div>

    {filtered.length > 0 ? (
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1rem;">
        {filtered.map((post) => <PostCard post={post} />)}
      </div>
    ) : (
      <p style="color:#64748B;text-align:center;padding:3rem 0;">No posts yet for this lens.</p>
    )}
  </section>
</BaseLayout>
