---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import FilterBar from '../components/FilterBar.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const sorted = allPosts.sort(
  (a, b) => b.data.published_at.getTime() - a.data.published_at.getTime()
);

const [featured, ...rest] = sorted;
---

<BaseLayout title="Home" description="AI intelligence through every lens. Data-backed analysis, no hype.">
  <section class="max-w-6xl mx-auto px-4 py-10">

    <!-- Hero tagline -->
    <div style="margin-bottom:2.5rem;">
      <h1 style="color:#F8FAFC;font-size:clamp(1.75rem,5vw,2.75rem);font-weight:700;line-height:1.15;margin:0 0 0.5rem 0;">
        AI intelligence.<br />
        <span style="color:#06B6D4;">Every lens.</span>
      </h1>
      <p style="color:#64748B;font-size:1rem;max-width:40rem;margin:0.75rem 0 0 0;line-height:1.6;">
        Research-grade sourcing across 5 layers. 7-point article scoring. No hype. Published for practitioners, analysts, and operators.
      </p>
    </div>

    <!-- Filter bar -->
    {allPosts.length > 0 && <FilterBar />}

    <!-- Featured post -->
    {featured && (
      <div style="margin-bottom:2rem;" data-post data-category={featured.data.category} data-pestle={featured.data.pestle.join(',')}>
        <p style="color:#64748B;font-size:0.7rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;margin:0 0 0.75rem 0;">Latest</p>
        <PostCard post={featured} featured={true} />
      </div>
    )}

    <!-- Post grid -->
    {rest.length > 0 && (
      <div>
        <p style="color:#64748B;font-size:0.7rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;margin:0 0 1rem 0;">Archive</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1rem;">
          {rest.map((post) => (
            <div data-post data-category={post.data.category} data-pestle={post.data.pestle.join(',')}>
              <PostCard post={post} />
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Empty state -->
    {allPosts.length === 0 && (
      <div style="text-align:center;padding:4rem 0;color:#64748B;">
        <p style="font-size:1.1rem;margin:0 0 0.5rem 0;">First post coming soon.</p>
        <p style="font-size:0.875rem;margin:0;">
          Subscribe to the <a href="https://linai.beehiiv.com/subscribe" style="color:#06B6D4;">newsletter</a> to be notified.
        </p>
      </div>
    )}
  </section>
</BaseLayout>
