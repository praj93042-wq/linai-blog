---
// Two dimensions share this bar. `/beat/*` is topic (GCC, HR, hiring) and leads,
// since it is the publication's focus. `/category/*` is form (research, opinion,
// markets). A post can appear under one of each.
// To add HR or Hiring later: { label: 'HR', href: '/beat/hr' } — the page and
// schema already support them.
const categories = [
  { label: 'GCC', href: '/beat/gcc' },
  { label: 'Research', href: '/category/research-breakdown' },
  { label: 'Tools', href: '/category/tool-analysis' },
  { label: 'Policy', href: '/category/policy-watch' },
  { label: 'Markets', href: '/category/market-intelligence' },
  { label: 'Opinion', href: '/category/opinion' },
];

const currentPath = Astro.url.pathname;
---

<header style="background-color: #0F172A; border-bottom: 1px solid #334155;">
  <nav class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-1 no-underline">
      <span style="font-size: 1.25rem; font-weight: 700; color: #F8FAFC; font-family: Inter, sans-serif; letter-spacing: -0.02em;">Lin</span>
      <span style="font-size: 1.25rem; font-weight: 700; color: #06B6D4; font-family: Inter, sans-serif; letter-spacing: -0.02em;">AI</span>
    </a>

    <!-- Category pills (hidden on very small screens) -->
    <div class="hidden sm:flex items-center gap-1 flex-wrap">
      {categories.map(({ label, href }) => (
        <a
          href={href}
          style={`
            display: inline-block;
            padding: 3px 10px;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 500;
            text-decoration: none;
            border: 1px solid;
            transition: all 0.15s;
            ${currentPath.startsWith(href)
              ? 'background-color: #06B6D4; color: #0F172A; border-color: #06B6D4;'
              : 'background-color: transparent; color: #CBD5E1; border-color: #334155;'}
          `}
        >
          {label}
        </a>
      ))}
    </div>

    <!-- Right side: About + RSS -->
    <div class="flex items-center gap-4">
      <a href="/about" style="color: #CBD5E1; font-size: 0.875rem; text-decoration: none;" class="hover:text-white">About</a>
      <a href="/rss.xml" title="RSS Feed" style="color: #CBD5E1; text-decoration: none;" class="hover:text-cyan-400">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
        </svg>
      </a>
    </div>
  </nav>

  <!-- Mobile category scroll -->
  <div class="sm:hidden px-4 pb-3 flex gap-2 overflow-x-auto" style="scrollbar-width: none;">
    {categories.map(({ label, href }) => (
      <a
        href={href}
        style={`
          flex-shrink: 0;
          padding: 3px 10px;
          border-radius: 9999px;
          font-size: 0.75rem;
          font-weight: 500;
          text-decoration: none;
          border: 1px solid;
          ${currentPath.startsWith(href)
            ? 'background-color: #06B6D4; color: #0F172A; border-color: #06B6D4;'
            : 'background-color: transparent; color: #CBD5E1; border-color: #334155;'}
        `}
      >
        {label}
      </a>
    ))}
  </div>
</header>
