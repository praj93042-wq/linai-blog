---
import CategoryBadge from './CategoryBadge.astro';
import PestleTag from './PestleTag.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, description, category, pestle, published_at, reading_time, big_number } = post.data;
const slug = post.data.slug;

const dateStr = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric', month: 'short', year: 'numeric',
}).format(published_at);
---

<article
  style={`
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 0.75rem;
    padding: ${featured ? '1.75rem' : '1.25rem'};
    transition: border-color 0.2s, box-shadow 0.2s;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
  `}
  onmouseenter="this.style.borderColor='#06B6D4';this.style.boxShadow='0 0 0 1px #06B6D420';"
  onmouseleave="this.style.borderColor='#334155';this.style.boxShadow='none';"
>
  <!-- Top: badge + pestle -->
  <div style="display:flex;flex-wrap:wrap;align-items:center;gap:6px;">
    <CategoryBadge category={category} size="sm" />
    <PestleTag pestle={pestle} />
  </div>

  <!-- Big number (featured only) -->
  {featured && big_number && (
    <div style="background-color:#0F172A;border-radius:0.5rem;padding:0.75rem 1rem;">
      <span style="color:#06B6D4;font-size:1.5rem;font-weight:700;">{big_number.value}</span>
      <span style="color:#CBD5E1;font-size:0.8rem;margin-left:0.5rem;">{big_number.label}</span>
    </div>
  )}

  <!-- Title -->
  <a
    href={`/${slug}`}
    style="color:#F8FAFC;font-weight:700;text-decoration:none;line-height:1.3;font-size:${featured ? '1.15rem' : '0.95rem'};"
  >
    {title}
  </a>

  <!-- Description -->
  <p style="color:#64748B;font-size:0.82rem;line-height:1.5;margin:0;flex:1;">
    {description}
  </p>

  <!-- Meta: date + reading time -->
  <div style="display:flex;align-items:center;gap:0.75rem;font-size:0.75rem;color:#64748B;margin-top:auto;">
    <span>{dateStr}</span>
    <span style="color:#334155;">·</span>
    <span>{reading_time} min read</span>
  </div>
</article>
