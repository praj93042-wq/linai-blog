---
interface Props {
  category: string;
  size?: 'sm' | 'md';
}

const { category, size = 'md' } = Astro.props;

const LABELS: Record<string, string> = {
  'research-breakdown': 'Research',
  'tool-analysis': 'Tool',
  'policy-watch': 'Policy',
  'market-intelligence': 'Markets',
  'opinion': 'Opinion',
  'weekly-roundup': 'Roundup',
  'deep-dive': 'Deep Dive',
};

const COLORS: Record<string, string> = {
  'research-breakdown': 'background-color:#312e81;color:#a5b4fc;border-color:#4338ca;',
  'tool-analysis':      'background-color:#0c4a6e;color:#7dd3fc;border-color:#0369a1;',
  'policy-watch':       'background-color:#7f1d1d;color:#fca5a5;border-color:#b91c1c;',
  'market-intelligence':'background-color:#064e3b;color:#6ee7b7;border-color:#047857;',
  'opinion':            'background-color:#78350f;color:#fcd34d;border-color:#b45309;',
  'weekly-roundup':     'background-color:#1E293B;color:#CBD5E1;border-color:#334155;',
  'deep-dive':          'background-color:#3b0764;color:#d8b4fe;border-color:#6d28d9;',
};

const label = LABELS[category] ?? category;
const colorStyle = COLORS[category] ?? 'background-color:#1E293B;color:#CBD5E1;border-color:#334155;';
const fontSize = size === 'sm' ? '0.68rem' : '0.75rem';
const padding = size === 'sm' ? '2px 7px' : '3px 10px';
---

<span style={`display:inline-block;padding:${padding};border-radius:9999px;font-size:${fontSize};font-weight:600;border:1px solid;${colorStyle}`}>
  {label}
</span>
